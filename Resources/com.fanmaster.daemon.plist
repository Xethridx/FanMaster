<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fanmaster.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/fanmaster</string>
        <string>--cli</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/fanmaster.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/fanmaster.log</string>
</dict>
</plist>
